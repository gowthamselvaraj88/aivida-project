# ===================================================
# Aivida Telehealth Backend Database Configuration
# ===================================================

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telehealth?sslmode=disable

# HTTP server port (Default: 8080)
PORT=8080

# Allowed frontend origins for CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
